{
  "name": "Remove Paywall",
  "short_name": "Unwall",
  "description": "Paste an article URL and read it in a clean reader view.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "url": "url", "text": "text", "title": "title" }
  }
}
